{
  "mcpServers": {
    "office": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=2",
        "python",
        "office_mcp.py"
      ],
      "env": {}
    },
    "office-remote": {
      "type": "http",
      "url": "https://safety-check-mcp.archina7.workers.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${SAFETY_CHECK_TOKEN}"
      }
    },
    "office-db": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-sqlite",
        "office.db"
      ],
      "env": {}
    }
  }
}
