{
  "mcpServers": {
    "office": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--no-project",
        "--with",
        "mcp>=2",
        "python",
        "office_mcp.py"
      ],
      "env": {}
    },
    "office-db": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-sqlite",
        "office.db"
      ],
      "env": {}
    }
  }
}
