# 로컬 비밀값. 이 파일을 .dev.vars 로 복사해서 값을 채운다 (.dev.vars 는 커밋하지 않는다).
# 하나라도 비어 있거나 SESSION_SECRET 이 32자 미만이면 서버가 모든 요청을 503 으로 막는다.

# Google Cloud Console > API 및 서비스 > 사용자 인증 정보 > OAuth 2.0 클라이언트 ID (웹 애플리케이션)
# 승인된 JavaScript 원본에 http://localhost:8788 과 배포 주소 https://safety-check-ezs.pages.dev를 넣는다.
GOOGLE_CLIENT_ID=

# 접속을 허용할 구글 이메일, 쉼표로 구분
ALLOWED_EMAILS=

# 세션 쿠키 서명용 임의 문자열 32자 이상. 예: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Claude API 키 (https://platform.claude.com/settings/keys). 서버 함수(functions/)에서 env.ANTHROPIC_API_KEY 로만 읽는다.
# 화면(public/)에는 절대 넣지 않는다. 운영 값은 Cloudflare 비밀값으로 넣는다:
#   npx wrangler pages secret put ANTHROPIC_API_KEY --project-name safety-check
# 이 예시 파일에는 키 값을 적지 않는다 (이 파일만 저장소에 올라간다).
ANTHROPIC_API_KEY=

# 모델 (비우면 기본값). 판단·작성 Agent 기본 claude-opus-5-5 / 단순 분류·추출 Worker 기본 claude-haiku-5-5
CLAUDE_MODEL=
CLAUDE_WORKER_MODEL=
